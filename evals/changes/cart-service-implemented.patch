@@ -9,3 +9,28 @@
 test('invalid cap uses the existing error contract', () => {
   assert.throws(() => validateCap(-1), { name: 'RangeError', message: 'Invalid discount cap' });
 });
+
+test('configured cap applies to both pricing paths and fresh config', () => {
+  const config = require('../src/cart/config');
+  const { cartTotal } = require('../src/cart/PriceCalculator');
+  const { DiscountCapRule } = require('../src/cart/DiscountCapRule');
+  const original = config.discountCapPercent;
+  try {
+    for (const cap of [20, 30, 50]) {
+      config.discountCapPercent = cap;
+      assert.equal(applyDiscount(100, 90), 100 - cap);
+      assert.equal(cartTotal([{ total: 100, discountPercent: 90 }]), 100 - cap);
+      assert.equal(applyDiscount(100, 10), 90);
+    }
+    assert.equal(cartTotal([]), 0);
+    const rule = new DiscountCapRule();
+    const scope = { discountPercent: 90, discountCapPercent: 50 };
+    assert.equal(rule.match(scope), true);
+    assert.equal(rule.apply(scope), undefined);
+    assert.equal(scope.discountPercent, 50);
+    for (const bad of [-1, NaN, Infinity]) {
+      config.discountCapPercent = bad;
+      assert.throws(() => applyDiscount(100, 90), { name: 'RangeError', message: 'Invalid discount cap' });
+    }
+  } finally { config.discountCapPercent = original; }
+});
