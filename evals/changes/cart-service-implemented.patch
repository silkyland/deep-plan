diff --git a/src/cart/DiscountCapRule.js b/src/cart/DiscountCapRule.js
new file mode 100644
--- /dev/null
+++ b/src/cart/DiscountCapRule.js
@@ -0,0 +1,13 @@
+const { RuleInterface } = require('../../vendor/rule-engine/RuleInterface');
+
+class DiscountCapRule extends RuleInterface {
+  match(scope) {
+    return Number.isFinite(scope.discountPercent) && scope.discountPercent > scope.discountCapPercent;
+  }
+
+  apply(scope) {
+    scope.discountPercent = scope.discountCapPercent;
+  }
+}
+
+module.exports = { DiscountCapRule };
